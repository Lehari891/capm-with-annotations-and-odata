<mvc:View
    controllerName="bookscapmfreestyle.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

<VBox id="_IDGenVBox" >
    <HBox id="_IDGenHBox" >
    <Button id="_IDGenButton" text="create" press="_CreateNewRecord"></Button>
    <Button id="_IDGenButton1" text="Update" press="_UpdateExistingRecord"></Button>
    <Button id="_IDGenButton2" text="Delete" press="_DeleteExistingRecord"></Button>
    <Button id="_IDGenButton3" text="Batch Upate" press="_BatchUpdate"></Button>
    </HBox>

    <HBox id="_IDGenHBox1" ><Button id="_IDGenButton4" text="Create with fragment" press="_CreateFragment"></Button>
    <Input id="idBooksVH" showValueHelp="true" valueHelpRequest="_onBookVH" ></Input>
    <Button id="_IDGenButton12" icon="sap-icon://refresh" press="_resetBooksTable"></Button>
    </HBox>
    </VBox>
    


        <content>

            <Table id="idBooksTable" items="{bk>/BooksSet}" mode="SingleSelectLeft" selectionChange="_showChapters">

                <columns>
                    <Column id="_IDGenColumn1">
                        <Text id="_IDGenText" text="Title" />
                        
                    </Column>

                    <Column id="_IDGenColumn2">
                        <Text id="_IDGenText1" text="Author" />
                    </Column>

                    <Column id="_IDGenColumn3">
                        <Text id="_IDGenText2" text="Price" />
                    </Column>
                    <Column id="_IDGenColumn11" >
                        <Text id="_IDGenText19"  text=" Discounted Price" />
                    </Column>

                    <Column id="_IDGenColumn4">
                        <Text id="_IDGenText3" text="Published Date" />
                    </Column>

                    <Column id="_IDGenColumn5">
                        <Text id="_IDGenText4" text="Gender" />
                    </Column>

                    <Column id="_IDGenColumn6">
                        <Text id="_IDGenText5" text="Age Group" />
                    </Column>   
                    <Column id="_IDGenColumn12" >
                        <Text id="_IDGenText23"  text="Status" />
                    </Column>

                </columns>

                <items>
                    <ColumnListItem id="_IDGenColumnListItem" type="Navigation" press="onItemPress">
                        <cells>
                            <Text id="_IDGenText6" text="{bk>title}" />
                            <Text id="_IDGenText7" text="{bk>author}" />
                            <Text id="_IDGenText8" text="{bk>price}" />
                            <!-- &gt; &lt;   expression binidng example and adding colors to the discounted and undiscounted price -->
                            <ObjectStatus id="_IDGenText22" text="{=${bk>price} &gt; 400 ?${bk>price}-100:${bk>price}}" state="{=${bk>price} &gt; 400? 'Success' : 'Error'}" />
                            <Text id="_IDGenText9" text="{bk>publishedDate}" />
                            <Text id="_IDGenText10" text="{bk>gender}" />
                            <Text id="_IDGenText11" text="{bk>ageGroup}" />
                            <!-- <core:Icon id="_IDGenIcon" src ="{=${bk>status}=== 'C' ? 'sap-icon://accept' : (${bk>status}=== 'I' ? 'sap-icon://pending':'sap-icon://alert')}" /> -->
                            <core:Icon id="_IDGenIcon" src="{path:'bk>status',formatter:'.formatter.formatStatusIcon'}"
                            color="{path:'bk>staus',formatter:'.formatter.formatStausColor'}"></core:Icon>
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
            
<Table id="idChaptersTable" items="{path:'ch>/'}" >
<headerToolbar>
 <OverflowToolbar id="_IDGenOverflowToolbar1">
 <content>
 <Title id="_IDGenTitle" text="Chapters" level="H2"/>
 </content>
 </OverflowToolbar>
 </headerToolbar>
 <columns>
 <Column id="_IDGenColumn">
 <Text id="_IDGenText12" text="Title" />
 </Column> 
 <Column id="_IDGenColumn7">
 <Text id="_IDGenText13" text="Pages" />
</Column>

 </columns> 
 <items>
 <ColumnListItem id="_IDGenColumnListItem1">
 <cells>
 <Text id="_IDGenText14" text="{ch>title}" />
 <Text id="_IDGenText15" text="{ch>pages}" />
  
 </cells>
 </ColumnListItem>
 </items>
</Table>

        </content>
    </Page>

</mvc:View>