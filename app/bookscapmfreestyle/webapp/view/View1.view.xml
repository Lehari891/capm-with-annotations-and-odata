<mvc:View
    controllerName="bookscapmfreestyle.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="page" title="{i18n>title}">
        <content>

            <Table id="idBooksTable" items="{bk>/BooksSet}" mode="SingleSelectLeft" selectionChange="_showChapters">

                <columns>
                    <Column id="_IDGenColumn1">
                        <Text id="_IDGenText" text="Title" />
                    </Column>

                    <Column id="_IDGenColumn2">
                        <Text id="_IDGenText1" text="Author" />
                    </Column>

                    <Column id="_IDGenColumn3">
                        <Text id="_IDGenText2" text="Price" />
                    </Column>

                    <Column id="_IDGenColumn4">
                        <Text id="_IDGenText3" text="Published Date" />
                    </Column>

                    <Column id="_IDGenColumn5">
                        <Text id="_IDGenText4" text="Gender" />
                    </Column>

                    <Column id="_IDGenColumn6">
                        <Text id="_IDGenText5" text="Age Group" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem id="_IDGenColumnListItem" type="Navigation" press="onItemPress">
                        <cells>
                            <Text id="_IDGenText6" text="{bk>title}" />
                            <Text id="_IDGenText7" text="{bk>author}" />
                            <Text id="_IDGenText8" text="{bk>price}" />
                            <Text id="_IDGenText9" text="{bk>publishedDate}" />
                            <Text id="_IDGenText10" text="{bk>gender}" />
                            <Text id="_IDGenText11" text="{bk>ageGroup}" />
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>
            
<Table id="idChaptersTable" items="{path:'ch>/'}" >
<headerToolbar>
 <OverflowToolbar id="_IDGenOverflowToolbar1">
 <content>
 <Title id="_IDGenTitle" text="Chapters" level="H2"/>
 </content>
 </OverflowToolbar>
 </headerToolbar>
 <columns>
 <Column id="_IDGenColumn">
 <Text id="_IDGenText12" text="Title" />
 </Column> 
 <Column id="_IDGenColumn7">
 <Text id="_IDGenText13" text="Pages" />
</Column>

 </columns> 
 <items>
 <ColumnListItem id="_IDGenColumnListItem1">
 <cells>
 <Text id="_IDGenText14" text="{ch>title}" />
 <Text id="_IDGenText15" text="{ch>pages}" />
  
 </cells>
 </ColumnListItem>
 </items>
</Table>

        </content>
    </Page>

</mvc:View>